# Copy into project root .env.local — Docker NOT required for dev
# Minimum: DATABASE_URL + PLATFORM_USE_PG_DIGEST=true

DATABASE_URL=postgresql://worldmonitor:worldmonitor@localhost:5432/hxxworldmonitor

# Optional — Platform ingest/API do not require Redis today
# REDIS_URL=redis://localhost:6379
# REDIS_RESP=2

# Optional — cold-tier archive skipped if OSS is unset
# OSS_ENDPOINT=http://localhost:9000
# OSS_ACCESS_KEY=worldmonitor
# OSS_SECRET_KEY=worldmonitor123
# OSS_BUCKET=wm-cold
# OSS_REGION=us-east-1
# OSS_FORCE_PATH_STYLE=true

# Platform services
PLATFORM_API_PORT=8787
# Auto-run deploy/init/*.sql migrations on platform:api startup (default on)
# PLATFORM_DB_AUTO_MIGRATE=true
PLATFORM_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
PLATFORM_INGEST_INTERVAL_MS=600000
PLATFORM_HOT_RETENTION_DAYS=180
PLATFORM_USE_PG_DIGEST=true

# Frontend news digest → Platform API first (fallback: Vite /api)
VITE_PLATFORM_API_URL=http://localhost:8787

# Embedding worker — Hugging Face model download (Xenova/all-MiniLM-L6-v2 ~23MB first run)
# If huggingface.co times out, use mirror (mainland China):
# HF_ENDPOINT=https://hf-mirror.com
# PLATFORM_HF_FETCH_TIMEOUT_MS=120000
# PLATFORM_HF_CACHE_DIR=D:/extProgramFiles/hf-cache
# PLATFORM_HF_ALLOW_REMOTE=false   # after model is cached — offline only

# HXXBOT tool marketplace — server reads .env.local via hxxbot-config.ts
HXXBOT_SITE_URL=https://www.hxxbot.com
# HXXBOT_API_URL=https://www.hxxbot.com/api
HXXBOT_API_KEY=
# HXXBOT_TOOL_VERSION=1.0.0

# Platform admin (/admin)
PLATFORM_ADMIN_EMAIL=admin@localhost
PLATFORM_ADMIN_PASSWORD=
# PLATFORM_JWT_SECRET=
# PLATFORM_ADMIN_SESSION_HOURS=24
# PLATFORM_ADMIN_TOKEN=   # optional legacy API bearer
PLATFORM_ADMIN_TOKEN=

# Platform file logging — logs/{service}/{date}.log
# PLATFORM_LOG_DIR=logs
# PLATFORM_LOG_LEVEL=info

# Existing LLM keys (fallback when HXXBOT not configured)
GROQ_API_KEY=
