# Copy into project root .env.local — Docker NOT required for dev
# Minimum: DATABASE_URL + PLATFORM_USE_PG_DIGEST=true

DATABASE_URL=postgresql://worldmonitor:worldmonitor@localhost:5432/hxxworldmonitor

# Optional — Platform ingest/API do not require Redis today
# REDIS_URL=redis://localhost:6379

# Optional — cold-tier archive skipped if OSS is unset
# OSS_ENDPOINT=http://localhost:9000
# OSS_ACCESS_KEY=worldmonitor
# OSS_SECRET_KEY=worldmonitor123
# OSS_BUCKET=wm-cold
# OSS_REGION=us-east-1
# OSS_FORCE_PATH_STYLE=true

# Platform services
PLATFORM_API_PORT=8787
PLATFORM_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
PLATFORM_INGEST_INTERVAL_MS=600000
PLATFORM_HOT_RETENTION_DAYS=180
PLATFORM_USE_PG_DIGEST=true

# Frontend news digest → Platform API first (fallback: Vite /api)
VITE_PLATFORM_API_URL=http://localhost:8787

# Existing LLM keys (for AI Brief — optional in Phase 1)
GROQ_API_KEY=
