# ============================================
# World Monitor — Environment Variables
# ============================================
# Copy: cp .env.example .env.local
#
# 本文件保留「启动与基础设施」变量（含对象存储 STORAGE_*）。
# 以下请在管理后台 /admin 配置（写入 PostgreSQL，勿写入 .env.local）：
#   · AI 模型 — Groq / OpenRouter / OpenAI 兼容 LLM
#   · 数据源配置 — HXXBOT、Finnhub、FRED、Relay 等外部 API
# ============================================


# ------ Cross-User Cache (Vercel — Upstash Redis) ------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------ Railway Relay (scripts/ais-relay.cjs — 尚未迁入 DB) ------
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNEL_SET=full
VITE_WS_RELAY_URL=
RELAY_AUTH_HEADER=x-relay-key
ALLOW_UNAUTHENTICATED_RELAY=false
RELAY_METRICS_WINDOW_SECONDS=60


# ------ Site Configuration ------
VITE_VARIANT=full
VITE_WS_API_URL=
VITE_SENTRY_DSN=
VITE_MAP_INTERACTION_MODE=3d


# ------ Desktop Cloud Fallback (Vercel) ------
WORLDMONITOR_VALID_KEYS=


# ------ Registration DB (Convex) ------
CONVEX_URL=


# ------ Self-hosted Platform ------
# See deploy/README.md and deploy/.env.platform.example

DATABASE_URL=postgresql://worldmonitor:worldmonitor@localhost:5432/hxxworldmonitor

REDIS_URL=redis://localhost:6379
REDIS_RESP=2

# ------ Object storage (local | oss | r2 — only the block matching STORAGE_TYPE is used) ------
STORAGE_TYPE=oss

# local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_BASE_URL=http://localhost:8787/uploads

# oss (local MinIO: deploy/docker-compose.yml)
STORAGE_OSS_ENDPOINT=http://localhost:9000
STORAGE_OSS_ACCESS_KEY_ID=worldmonitor
STORAGE_OSS_ACCESS_KEY_SECRET=worldmonitor123
STORAGE_OSS_BUCKET=wm-cold
STORAGE_OSS_REGION=us-east-1
STORAGE_OSS_FORCE_PATH_STYLE=true
# STORAGE_OSS_BASE_URL=

# r2 (Cloudflare R2, S3-compatible)
# STORAGE_R2_ACCOUNT_ID=
# STORAGE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_R2_ACCESS_KEY_ID=
# STORAGE_R2_SECRET_ACCESS_KEY=
# STORAGE_R2_BUCKET=
# STORAGE_R2_REGION=auto
# STORAGE_R2_BASE_URL=

PLATFORM_API_PORT=8787
# Auto-apply SQL migrations on platform:api / worker startup (default: true). Set false only for locked-down prod.
PLATFORM_DB_AUTO_MIGRATE=true
PLATFORM_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
PLATFORM_USE_PG_DIGEST=true

VITE_PLATFORM_API_URL=http://localhost:8787

# Platform admin bootstrap (run npm run platform:admin:init once)
PLATFORM_ADMIN_EMAIL=admin@localhost
PLATFORM_ADMIN_PASSWORD=
# PLATFORM_JWT_SECRET=
# PLATFORM_ADMIN_TOKEN=

# Ingest / digest tuning (not secrets)
PLATFORM_INGEST_INTERVAL_MS=600000
PLATFORM_HOT_RETENTION_DAYS=180

# HF model cache for embeddings (not an API key)
# HF_ENDPOINT=https://hf-mirror.com
# PLATFORM_HF_FETCH_TIMEOUT_MS=120000

# PLATFORM_LOG_DIR=logs
# PLATFORM_LOG_LEVEL=info
